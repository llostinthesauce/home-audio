# Apple Music Toolkit — environment configuration
# Copy this to .env and edit paths for your system:
#   cp .env.example .env
#
# amt.sh will prompt you to create .env on first run.

# ── Required ──────────────────────────────────────────────────────────

# Root of your local ALAC music library (Artist/Album/Track.m4a structure)
MUSIC_ROOT="$HOME/Music"

# Apple Music XML export path (File → Library → Export Library in Music.app)
XML_DEFAULT="$HOME/Desktop/Library.xml"

# iPod mount point (check with `diskutil list`)
IPOD_MOUNT="/Volumes/iPod"

# Apple Music XML export of your iCloud/cloud library, for the cloud-vs-local diff scripts
# CLOUD_XML="$HOME/Desktop/CloudLibrary.xml"

# Separate sync library used by build_ipod_tree.py
# IPOD_SYNC_ROOT="$HOME/Music/SyncLibraries/iPodVideo/Music"

# ── Optional ──────────────────────────────────────────────────────────

# AcoustID API key — required only for fingerprint-based scripts
# (acoustic_cloud_sync.py, track_swap_detector.py).
# Register a free key at: https://acoustid.org/new-application
# ACOUSTID_API_KEY="your_key_here"

# Override output directory for reports and exports (default: ./output/)
# OUTPUT_DIR="$HOME/Music/toolkit-output"

# Override scan results location (default: ./output/scan_results.json)
# SCAN_RESULTS="/path/to/scan_results.json"

# Override loudness report path (default: ./output/loudness_report.csv)
# LOUDNESS_REPORT="/path/to/loudness_report.csv"

# Override playlist export directory (default: ./output/playlists/)
# PLAYLISTS_OUT="/path/to/playlists"


# Spotify app credentials, only for spotify.py (https://developer.spotify.com/dashboard)
# SPOTIPY_CLIENT_ID="..."
# SPOTIPY_CLIENT_SECRET="..."
# SPOTIPY_REDIRECT_URI="http://127.0.0.1:8888/callback"
